# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=hyipro
DB_PORT=3306

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Frontend Configuration
FRONTEND_URL=http://localhost:5173

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000              # 15 minutes in milliseconds
RATE_LIMIT_REGULAR_MAX=1000              # Regular users: 1000 requests per 15 min
RATE_LIMIT_PREMIUM_MAX=2000              # Premium users: 2000 requests per 15 min
RATE_LIMIT_AUTH_MAX=20                   # Auth routes: 20 requests per 15 min (stricter)
RATE_LIMIT_ADMIN_BYPASS=true             # Admins bypass rate limiting

# Email Configuration (Resend)
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=noreply@yourdomain.com

# Sentry Configuration (optional)
SENTRY_DSN=

# File Upload Configuration
MAX_FILE_SIZE=5242880                   # 5MB in bytes

# Deposit/Withdrawal Limits
MIN_DEPOSIT=50
MAX_DEPOSIT=5000
MIN_WITHDRAWAL=1000
MAX_WITHDRAWAL=50000
